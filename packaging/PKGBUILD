# Maintainer: Luiz Felipe - F360c4 <f360c4@gmail.com>
pkgname=f3note
pkgver=0.1.0
pkgrel=1
pkgdesc="A fast, minimal tabbed text editor for Wayland"
arch=('x86_64' 'aarch64')
url="https://github.com/f360c4/f3note"
license=('MIT')
depends=('gtk4' 'gtksourceview5')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  # Build offline from the committed lock file, which is what makes the
  # package reproducible and lets it build on a machine with no network.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin f3note
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Only the tests that need no display; the window tests are a separate
  # binary and are not run here.
  cargo test --frozen --release --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "packaging/io.github.f360c4.$pkgname.desktop" \
    "$pkgdir/usr/share/applications/io.github.f360c4.$pkgname.desktop"
  install -Dm644 "packaging/$pkgname.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.f360c4.$pkgname.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/MANUAL.md "$pkgdir/usr/share/doc/$pkgname/MANUAL.md"
}
